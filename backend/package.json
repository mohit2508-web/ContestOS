{
  "name": "kryptaviaos-backend",
  "version": "1.0.0",
  "description": "Kryptavia OS Engine API Server - Safe Exam Browser, Live Leaderboards & Code Execution",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/app.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "start": "node dist/app.js",
    "postinstall": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^5.20.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsdom": "^24.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-sql-parser": "^5.4.0",
    "playwright": "^1.62.1",
    "sql.js": "^1.14.1",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2"
  }
}
